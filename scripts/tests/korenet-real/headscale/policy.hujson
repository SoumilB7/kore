// The rig's tailnet policy: every node of the owner reaches every other (as a personal tailnet
// does), and Tailscale SSH lets the owner in as any user of their own nodes (scenario tailscale-ssh).
{
  "acls": [{"action": "accept", "src": ["*"], "dst": ["*:*"]}],
  "ssh": [{"action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]}]
}
